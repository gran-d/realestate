FROM golang:1.26-alpine AS builder

# gcc и musl-dev нужны для пакета github.com/lib/pq
# lib/pq использует CGO (вызовы C-библиотек), без gcc компиляция упадёт
RUN apk add --no-cache gcc musl-dev

WORKDIR /app
# Все следующие команды выполняются в папке /app внутри контейнера

# ── Шаг: скачать зависимости ──────────────────────────────────
# Копируем ТОЛЬКО go.mod и go.sum перед остальным кодом.
# Зачем: Docker кэширует каждую строку (слой).
# Если go.mod не изменился — Docker использует кэш и не скачивает
# зависимости заново. Экономит минуты при каждой пересборке.
COPY go.mod go.sum ./
RUN go mod download

# ── Шаг: скопировать код и собрать ───────────────────────────
# Теперь копируем весь остальной код
# .dockerignore исключит .env, .git и docs/
COPY . .

# Компилируем бинарник
# CGO_ENABLED=1   — включаем CGO (нужен для lib/pq)
# GOOS=linux      — собираем для Linux (Alpine работает на Linux)
# -ldflags="-w -s" — убираем отладочные символы → меньше размер файла
#   -w: без DWARF отладочной информации
#   -s: без таблицы символов
# -o server       — имя выходного бинарника
# ./cmd/main.go   — файл с функцией main
RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-w -s" \
    -o server \
    ./cmd/main.go

# ═══════════════════════════════════════════════════════════════
# ЭТАП 2: ФИНАЛЬНЫЙ ОБРАЗ
# Маленький Alpine — только операционная система и наш бинарник
# ═══════════════════════════════════════════════════════════════
FROM alpine:3.19

# ca-certificates — нужны для HTTPS соединений (если будем звать внешние API)
# tzdata — корректная работа с временными зонами (для time.Now())
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# COPY --from=builder — копируем файл из ПЕРВОГО этапа (builder), не с хоста
# Копируем только собранный бинарник — Go компилятор нам больше не нужен
COPY --from=builder /app/server .

# Миграции на случай ручного запуска внутри контейнера
COPY --from=builder /app/migrations ./migrations

# Документируем что приложение будет слушать порт 3000
# EXPOSE не пробрасывает порт — это только метка. Реальный проброс в docker-compose.
EXPOSE 3000

# Команда запуска контейнера
CMD ["./server"]